<script type="text/javascript">
    var initial_state = {
        pType: "algorithm",
        slug: "count-pairs-01cd4368",
        title: "Count Pairs",
        topicTree: "",
        problemData: {"id": 394243, "title": "Count Pairs", "description": "<p>Given a number <strong>n</strong> you have to count number of <strong>pairs (x,y) such that x * y = n and gcd(x, y) = 1</strong></p>\n<p><strong>Note:</strong> gcd(x, y) is the greatest number that divides both x and y.</p>\n<p>Refer: <a href=\"https://en.wikipedia.org/wiki/Greatest_common_divisor\">link</a>\n</p>\n<p>Use of Fast I/O is recommended.\n</p>\n<p><br />\n</p>\n<p><strong>Input format:</strong>\n</p>\n<p>First line consists of a number <strong>T</strong>, denoting number of test cases. </p>\n<p>Each of the next <strong>T</strong> lines contains a single number <strong>N</strong>. </p>\n<p><br />\n</p>\n<p><strong>Output format:</strong>\n</p>\n<p>Output the required answer on a new line.</p>\n<p><br />\n</p>\n<p><strong>Constraints:</strong></p>\n<p>1 \u2264 <strong>T</strong> \u2264 10^6</p>\n<p>1 \u2264 <strong>N</strong> \u2264 10^7</p>\n<p></p>\n<p></p>\n<p></p>", "sample_explanation": "<p>For 1st test case, pairs are (1, 2) and (2, 1)</p>\n<p>For 2nd test case, pairs are (1, 6), (6, 1), (2, 3) and (3, 2).</p>", "tags": "Prime Factorization, Medium, Math", "level": "M", "private_url_hash": "dd07a8c9bded4c3abbdc32554a608280", "ratings": {"score": 0.0, "votes": 0}, "success_rate": 60, "points": 30, "attempted_by": 945, "bookmarked": false, "time_limit": 1.0, "memory_limit": 256, "max_code_size": 1024, "editorial": {"state": "do-not-exist"}},
